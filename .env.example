# ==============================================================================
# PaySight Environment Configuration
# ==============================================================================
# ZERO-CONFIGURATION DEMO MODE:
# If left empty, PaySight operates in Demo Mode using persistent local storage
# (.data/paysight-db.json) with deterministic sample data.
# ==============================================================================

# ─── PayPal Sandbox Credentials ──────────────────────────────────────────────
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
# Important: Enable "Transaction Search" & "Invoicing" in your Sandbox App features.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# ─── AI Model Configuration (Google Gemini) ──────────────────────────────────
# Obtain from https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-omni-1.1-flash

# ─── Market Intelligence (Channel3) ──────────────────────────────────────────
# Optional: Live competitor pricing API from https://trychannel3.com/
# If omitted, PaySight uses structured multi-retailer catalog listings.
CHANNEL3_API_KEY=
